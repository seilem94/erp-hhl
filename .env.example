# Copia este archivo a .env en la raiz y completa los secretos antes de arrancar.
# No compartas ni versiones el archivo .env real.

# Usuario y base: usa letras, numeros y guion bajo (se insertan en DATABASE_URL).
POSTGRES_USER=hhl
POSTGRES_DB=hhl_erp
# Obligatoria: genera una clave aleatoria hexadecimal de 64 caracteres.
# Hexadecimal evita caracteres que necesiten codificacion en DATABASE_URL.
POSTGRES_PASSWORD=

# production deshabilita la identidad Dummy; no implica autenticacion implementada.
ENV=production

# Acceso de prueba local: http://127.0.0.1:8080, sin publicacion hacia la LAN.
FRONTEND_PORT=8080

# Solo para docker compose --profile tunnel up -d --build: pega el token real.
# Configura en Cloudflare el origen HTTP del hostname publico: http://frontend:80.
TUNNEL_TOKEN=
